# URL pública del backend en producción (incluye el prefijo /api).
# En local se deja vacío: Vite hace proxy de /api hacia localhost:4000
# (ver vite.config.js), así que no hace falta definir esta variable.
VITE_API_URL=https://salud-backend.vercel.app/api

# Opcional: DSN de un proyecto en sentry.io para monitoreo de errores
# de frontend en producción. Sin definir, el SDK no envía nada.
VITE_SENTRY_DSN=
