PORT=4000

# Cadena de conexión de la base de datos de ESTE cliente (una base de
# datos por tenant). En local, algo como:
#   postgresql://postgres:postgres@localhost:5432/Salud
# En producción (Neon), la cadena que te da el panel de Neon para ese
# proyecto específico.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salud

JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173
